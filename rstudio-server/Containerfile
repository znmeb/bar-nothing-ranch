FROM docker.io/library/ubuntu:resolute
LABEL maintainer="M. Edward (Ed) Borasky <znmeb@algocompsynth.com>"

ARG RSTUDIO_USER=$RSTUDIO_USER
ARG RSTUDIO_PASSWD=$RSTUDIO_PASSWD
ARG RSTUDIO_FULLNAME=$RSTUDIO_FULLNAME
ARG RSTUDIO_PACKAGE=$RSTUDIO_PACKAGE

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && \
    apt-get install -qqy --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        r-base-dev \
        sudo \
        ubuntu-server-minimal \
        wget && \
    apt-get clean -y

RUN usermod \
        --comment "${RSTUDIO_FULLNAME}" \
        --home "/home/${RSTUDIO_USER}" \
        --login "${RSTUDIO_USER}" \
        --move-home \
        ubuntu && \
    echo "${RSTUDIO_USER}:${RSTUDIO_PASSWD}" | chpasswd

# https://docs.posit.co/ide/server-pro/admin/getting_started/installation/install-rstudio-server.html#download-and-install
RUN wget --quiet "${RSTUDIO_PACKAGE}" && \
    apt-get install -qqy \
        ./rstudio-server-*.deb && \
    apt-get clean -y && \
    rm rstudio-server-*.deb

# https://cran4linux.github.io/bspm/#ubuntu
RUN . /etc/os-release && \
    URL="https://raw.githubusercontent.com/eddelbuettel/r2u/master/inst/scripts" && \
    curl -s "${URL}/add_cranapt_${UBUNTU_CODENAME}.sh" | bash -s && \
    apt-get clean -y

CMD /sbin/init
