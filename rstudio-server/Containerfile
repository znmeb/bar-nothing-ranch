FROM docker.io/library/ubuntu:resolute
LABEL maintainer="M. Edward (Ed) Borasky <znmeb@algocompsynth.com>"

ARG RSTUDIO_USER=$RSTUDIO_USER
ARG RSTUDIO_PASSWD=$RSTUDIO_PASSWD
ARG RSTUDIO_FULLNAME=$RSTUDIO_FULLNAME
ARG RSTUDIO_PACKAGE=$RSTUDIO_PACKAGE

ARG RSTUDIO_HOME="/home/${RSTUDIO_USER}"
ARG RSTUDIO_LOGFILES="${RSTUDIO_HOME}/Logfiles"
ARG RSTUDIO_SCRIPTS="${RSTUDIO_HOME}/Scripts"
ARG RSTUDIO_PROJECTS="${RSTUDIO_HOME}/Projects"
ARG RSTUDIO_LOCALBIN="${RSTUDIO_HOME}/.local/bin"

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq \
    2>&1 | gzip -9c > /apt-update.log.gz
RUN apt-get install -qqy \
        apt-file \
        ca-certificates \
        cmake \
        curl \
        dialog \
        git \
        gnupg \
        locales \
        openssh-client \
        r-base-dev \
        sudo \
        ubuntu-server-minimal \
        wget \
        2>&1 | gzip -9c > /apt-install.log.gz

RUN echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && \
    /usr/sbin/locale-gen

RUN usermod \
        --comment "${RSTUDIO_FULLNAME}" \
        --home "${RSTUDIO_HOME}" \
        --login "${RSTUDIO_USER}" \
        --move-home \
        ubuntu && \
    groupmod --new-name "${RSTUDIO_USER}" ubuntu && \
    echo "${RSTUDIO_USER}:${RSTUDIO_PASSWD}" | chpasswd

# https://docs.posit.co/ide/server-pro/admin/getting_started/installation/install-rstudio-server.html#download-and-install
RUN wget --quiet "${RSTUDIO_PACKAGE}" && \
    apt-get install -qqy \
        ./rstudio-server-*.deb \
        2>&1 | gzip -9c > /rstudio-server.log.gz && \
    rm rstudio-server-*.deb

# https://cran4linux.github.io/bspm/#ubuntu
RUN . /etc/os-release && \
    URL="https://raw.githubusercontent.com/eddelbuettel/r2u/master/inst/scripts" && \
    curl -s "${URL}/add_cranapt_${UBUNTU_CODENAME}.sh" | bash -s \
    2>&1 | gzip -9c > /bspm.log.gz

RUN Rscript -e "install.packages(c('devtools', 'remotes'))" \
    2>&1 | gzip -9c > /r-devtools.log.gz
RUN Rscript -e "update.packages()" \
    2>&1 | gzip -9c > /r-update.log.gz

COPY --chown="${RSTUDIO_USER}:${RSTUDIO_USER}" scripts/ $RSTUDIO_SCRIPTS/
RUN mkdir -p $RSTUDIO_PROJECTS $RSTUDIO_LOGFILES $RSTUDIO_LOCALBIN && \
    chown -R "${RSTUDIO_USER}:${RSTUDIO_USER}" $RSTUDIO_HOME && \
    mkdir -p /home/linuxbrew/.linuxbrew/ && \
    chown -R "${RSTUDIO_USER}:${RSTUDIO_USER}" /home/linuxbrew/.linuxbrew/

USER $RSTUDIO_USER
WORKDIR $RSTUDIO_SCRIPTS

RUN ./command-line-base.sh

USER root
WORKDIR /

RUN cp \
    $RSTUDIO_HOME/.local/share/fonts/CaskaydiaCoveNerdFont-Regular.ttf \
    /etc/rstudio/fonts/

CMD /sbin/init
